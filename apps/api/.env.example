# PostgreSQL (docker-compose local)
DATABASE_URL="postgresql://navex:navex_dev_pw@localhost:5432/navexwms?schema=public"

# Clés RSA générées via `pnpm gen:keys` à la racine du monorepo
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Durées de vie des tokens
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Serveur
PORT=3001
WEB_ORIGIN=http://localhost:3000

# URL publique de l'app (encodée dans les QR des décharges)
APP_PUBLIC_URL=http://localhost:3000

# Durée de validité du QR d'une décharge (heures)
DECHARGE_TTL_HEURES=72

# Stockage S3-compatible (MinIO en dev : docker compose up minio)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=navex-media
S3_ACCESS_KEY=navex
S3_SECRET_KEY=navex_dev_pw
S3_FORCE_PATH_STYLE=true
# Laisser vide si le bucket est servi directement via l'endpoint S3
S3_PUBLIC_BASE_URL=
